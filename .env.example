PORT=3000
LOG_LEVEL=info

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offer-task-queue

# Base URL of this same Express service (suppliers are mounted on it).
# Activities call out to these URLs over HTTP so they remain real "network calls".
SUPPLIER_A_URL=http://app:3000/supplierA
SUPPLIER_B_URL=http://app:3000/supplierB

# HTTP timeout for supplier calls made from Temporal activities (ms)
SUPPLIER_HTTP_TIMEOUT_MS=5000
